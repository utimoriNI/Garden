filters:
  and:
    - file.ext == "md"
    - file.inFolder("500_Fleeting")
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  file.tags:
    displayName: Tags
  file.mtime:
    displayName: Updated
views:
  - type: list
    name: Fleeting
    order:
      - file.name
      - file.ctime
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 340
    rowHeight: medium
    indentProperties: true
  - type: cards
    name: ビュー
    sort:
      - property: file.ctime
        direction: DESC

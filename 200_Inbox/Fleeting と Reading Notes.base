filters:
  and:
    - file.ext == "md"
    - or:
        - file.inFolder("500_Fleeting")
        - and:
            - file.inFolder("300_Input/Reading Notes")
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  file.tags:
    displayName: Tags
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Fleeting と Reading Notes
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.folder
      - file.tags
      - file.mtime
